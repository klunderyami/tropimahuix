rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.uid == "QOKcpcAF1EayBKXRqKVNjZrwuiz2";
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'description', 'price', 'volume', 'image', 'category', 'stock']) &&
        data.keys().hasOnly(['name', 'description', 'price', 'volume', 'image', 'category', 'stock', 'active']) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.description is string &&
        data.description.size() > 0 &&
        data.description.size() <= 1200 &&
        data.price is number &&
        data.price > 0 &&
        data.volume is string &&
        data.volume.size() > 0 &&
        data.volume.size() <= 30 &&
        data.image is string &&
        data.image.size() > 0 &&
        data.category in ['licor', 'torito'] &&
        data.stock is int &&
        data.stock >= 0 &&
        (!('active' in data) || data.active is bool);
    }

    function isValidShippingAddress(address) {
      return address.keys().hasAll(['name', 'email', 'phone', 'street', 'city']) &&
        address.name is string &&
        address.name.size() >= 2 &&
        address.name.size() <= 120 &&
        address.email is string &&
        address.email.size() >= 5 &&
        address.email.size() <= 160 &&
        address.phone is string &&
        address.phone.size() >= 8 &&
        address.phone.size() <= 30 &&
        address.street is string &&
        address.street.size() >= 4 &&
        address.street.size() <= 240 &&
        address.city is string &&
        address.city.size() >= 2 &&
        address.city.size() <= 120;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status', 'shippingAddress', 'paypalOrderId', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'items', 'total', 'status', 'shippingAddress', 'paypalOrderId', 'createdAt']) &&
        data.userId is string &&
        data.items is list &&
        data.items.size() > 0 &&
        data.items.size() <= 50 &&
        data.total is number &&
        data.total > 0 &&
        data.status in ['pending', 'paid', 'failed', 'delivered'] &&
        data.paypalOrderId is string &&
        data.paypalOrderId.size() > 0 &&
        data.paypalOrderId.size() <= 120 &&
        data.createdAt is string &&
        isValidShippingAddress(data.shippingAddress);
    }

    function isValidFulfillmentUpdate() {
      return isValidOrder(request.resource.data) &&
        resource.data.diff(request.resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['pending', 'paid', 'failed', 'delivered'];
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isAdmin() && isValidOrder(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && isValidFulfillmentUpdate();
      allow delete: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
