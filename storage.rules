rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Carpeta de productos: solo usuarios autenticados pueden subir
    // Cualquier persona puede leer (descargar) las imágenes
    match /productos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024  // 5MB máximo
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Blindaje: denegar cualquier otro acceso
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}