# ============================================
# FRONTEND ENVIRONMENT VARIABLES (VITE_*)
# ============================================
# Nota: Todas las variables VITE_ son accesibles en el navegador

# ID de usuario de Firebase que tendrá acceso al panel de administración
# Obtén tu UID desde Firebase Console → Authentication → Users
VITE_FIREBASE_ADMIN_UID=OsVU7qU5NOParGXVqejx0SacMLl2

# URL base de la API (usar / para mismo dominio en producción)
VITE_API_BASE_URL=/

# PayPal (Sandbox para desarrollo, Live para producción)
VITE_PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
VITE_PAYPAL_MODE=LIVE

# Firebase Client Configuration
# Obtener estas credenciales de Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id_aqui
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id_aqui
VITE_FIREBASE_APP_ID=1:XXXXXXXXXXXX:XXXXXXXXXXXXXXX

# ============================================
# BACKEND ENVIRONMENT VARIABLES (Server-side)
# ============================================
# Puerto del servidor Express
PORT=9005

# Firebase Admin SDK Credentials
# Obtener de Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=tu_proyecto_id_aqui
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Admin UID (mismo que VITE_FIREBASE_ADMIN_UID)
ADMIN_UID=OsVU7qU5NOParGXVqejx0SacMLl2

# PayPal Server Credentials
PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui
PAYPAL_MODE=LIVE
PAYPAL_CURRENCY=MXN

# Origen permitido para CORS (producción)
CLIENT_ORIGIN=https://tudominio.com

# Webhook de notificaciones (opcional - Discord/Slack)
NOTIFICATION_WEBHOOK_URL=