# Configuración de Reddit API
# Obtén estas credenciales en https://www.reddit.com/prefs/apps

# ID del cliente de Reddit (14 caracteres)
REDDIT_CLIENT_ID=tu_client_id_aqui

# Secret del cliente de Reddit
REDDIT_CLIENT_SECRET=tu_client_secret_aqui

# Usuario de Reddit
REDDIT_USER=tu_usuario_reddit

# Contraseña de Reddit
REDDIT_PASS=tu_contraseña_reddit

# User Agent (opcional, por defecto: RedditBot/1.0 by Tropicana)
REDDIT_USER_AGENT=RedditBot/1.0 by Tropicana

# Configuración de Supabase (para el bot de Reddit)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Configuración de Notificaciones (API key para enviar notificaciones desde webhooks)
NOTIFICATION_API_KEY=tu_api_key_secreta_aqui
