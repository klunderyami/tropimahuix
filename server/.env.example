# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Nota: NUNCA compartir estos valores. Mantener privados.

# Express Server
PORT=9005

# CORS - Origen permitido para requests desde el frontend
CLIENT_ORIGIN=http://localhost:5173

# Admin UID - Debe coincidir con VITE_ADMIN_UID del frontend
ADMIN_UID=tu_admin_uid_aqui

# Webhook para notificaciones de nuevas órdenes (Discord, Slack, etc)
NOTIFICATION_WEBHOOK_URL=tu_webhook_aqui

# ============================================
# PAYPAL CONFIGURATION
# ============================================
# PAYPAL_MODE: sandbox (desarrollo) o live (producción)
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=MXN

# Credenciales de PayPal Developer
# Obtener en: https://developer.paypal.com → App & Credentials
PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui

# ============================================
# FIREBASE ADMIN CONFIGURATION
# ============================================
# Opción 1 (Recomendado para Render): Usar FIREBASE_CONFIG_BASE64
# Convertir tu serviceAccountKey.json a Base64:
# cat serviceAccountKey.json | base64
FIREBASE_CONFIG_BASE64=eyAicHJvamVjdElkIjogInR1X3Byb2plY3RvaWQiLCAiY2xpZW50RW1haWwiOiAidHlfZW1haWxAdXJsLmNvbSIsICJwcml2YXRlS2V5IjogInR1X3ByaXZhdGVfa2V5IiB9

# Opción 2: Usar variables individuales (para desarrollo local)
# Obtener estas credenciales de Firebase Console → Project Settings → Service Accounts
FIREBASE_ADMIN_PROJECT_ID=tu_proyecto_id_aqui
FIREBASE_ADMIN_CLIENT_EMAIL=tu_cuenta_servicio@tu_proyecto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----\n"
